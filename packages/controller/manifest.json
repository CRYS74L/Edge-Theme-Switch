{
  "manifest_version": 3,
  "name": "Edge 浏览器外观切换",
  "version": "1.0.0.3",
  "version_name": "1.0.1-dev.3-preview",
  "description": "单击工具栏图标即可在当前 Edge 的浅色和深色整体外观之间切换；不修改 Windows 主题或网页内容。",
  "key": "",
  "permissions": [
    "management"
  ],
  "background": {
    "service_worker": "src/service-worker.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "切换模式",
    "default_icon": {
      "16": "icons/icon-light-16.png",
      "32": "icons/icon-light-32.png",
      "48": "icons/icon-light-48.png",
      "128": "icons/icon-light-128.png"
    }
  }
}
