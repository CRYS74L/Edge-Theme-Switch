{
  "manifest_version": 3,
  "name": "Edge 外观一键切换",
  "version": "1.1.1.11",
  "version_name": "1.1.1-dev.11-preview",
  "description": "一键切换 Edge 浅色与深色外观；B站网页全屏、直播间及 YouTube 影院模式自动进入深色，离开时仅撤销自动切换。",
  "key": "",
  "permissions": [
    "management",
    "storage",
    "scripting"
  ],
  "background": {
    "service_worker": "src/service-worker.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "切换模式",
    "default_icon": {
      "16": "icons/icon-light-16.png",
      "32": "icons/icon-light-32.png",
      "48": "icons/icon-light-48.png",
      "128": "icons/icon-light-128.png"
    }
  },
  "host_permissions": [
    "https://www.bilibili.com/*",
    "https://live.bilibili.com/*",
    "https://www.youtube.com/*",
    "https://youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/video/*",
        "https://live.bilibili.com/*",
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": [
        "src/watch-state.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
