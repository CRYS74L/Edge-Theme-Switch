{
  "manifest_version": 3,
  "name": "Edge 网页深浅色切换",
  "version": "0.2.0",
  "description": "单击工具栏图标即可切换当前普通网页的深色视觉模式，不修改 Windows 或 Edge 浏览器框架主题。",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "src/service-worker.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "单击切换当前网页深浅色",
    "default_icon": {
      "16": "icons/icon-light-16.png",
      "32": "icons/icon-light-32.png",
      "48": "icons/icon-light-48.png",
      "128": "icons/icon-light-128.png"
    }
  }
}
