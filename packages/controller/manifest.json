{
  "manifest_version": 3,
  "name": "Edge 浏览器主题切换",
  "version": "0.1.0",
  "description": "单击工具栏图标即可在本项目的浅色和深色 Edge 浏览器主题之间切换。",
  "key": "",
  "permissions": [
    "management"
  ],
  "background": {
    "service_worker": "src/service-worker.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "单击切换 Edge 浏览器主题",
    "default_icon": {
      "16": "icons/icon-light-16.png",
      "32": "icons/icon-light-32.png",
      "48": "icons/icon-light-48.png",
      "128": "icons/icon-light-128.png"
    }
  }
}
