{
  "name": "edge-browser-theme-toggle",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "release:build": "node scripts/build-release.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:action": "node --test tests/controller-native-message.test.mjs",
    "test:manifests": "node --test tests/manifest-contract.test.mjs",
